		"predeploy": "convex deploy --cmd 'bun run build' --cmd-url-env-var-name VITE_CONVEX_URL"
	},
	"dependencies": {
		"@ariakit/react": "^0.4.17",
		"@iconify/react": "^6.0.0",
		"@tailwindcss/vite": "^4.1.5",
		"arktype": "^2.1.20",
		"convex": "^1.23.0",
		"convex-helpers": "^0.1.81",
		"date-fns": "^4.1.0",
		"es-toolkit": "^1.36.0",
		"pretty-ms": "^9.2.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"space-slug": "^2.1.0",
		"tailwindcss": "^4.1.5",
		"wouter": "^3.7.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.22.0",
		"@types/react": "^19.0.10",
		"@types/react-dom": "^19.0.4",
		"@vitejs/plugin-react-swc": "^3.8.0",
		"eslint": "^9.22.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.19",
		"globals": "^16.0.0",
		"npm-run-all": "^4.1.5",
		"typescript": "~5.7.2",
		"typescript-eslint": "^8.26.1",
		"vite": "^6.3.1"
