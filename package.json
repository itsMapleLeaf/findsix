{
	"name": "findsix",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "convex dev --until-success && run-p 'dev:*'",
		"dev:vite": "vite",
		"dev:convex": "convex dev --tail-logs",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
